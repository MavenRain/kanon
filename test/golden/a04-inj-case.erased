rec [sum<i31|i31>]
fun left () : union sum<i31|i31> := KTag sum<i31|i31> 0 [KLit 1]
rec [sum<i31|i31>]
fun right () : union sum<i31|i31> := KTag sum<i31|i31> 1 [KLit 2]
rec [sum<i31|i31>]
fun plain (union sum<i31|i31>) : i31 := KCase (KVar 0) [{0 1 (KVar 0)}; {1 1 (KVar 0)}]
