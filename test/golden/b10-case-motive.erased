erased Nat
erased Two
rec [sum<i31|i31>]
fun plain (union sum<i31|i31>) : i31 := KCase sum<i31|i31> (KVar 0) [{0 1 (KVar 0)}; {1 1 (KTail (KGlobal natAdd) [KVar 0; KLit 1])}]
rec [sum<i31|i31>]
fun withMotive (union sum<i31|i31>) : i31 := KCase sum<i31|i31> (KVar 0) [{0 1 (KVar 0)}; {1 1 (KVar 0)}]
rec [any]
fun fromVoid () : union any := KCase any (KErased) []
