rec []
fun add3 (i31, i31) : i31 := KTail (KGlobal natAdd) [KApp (KGlobal natAdd) [KVar 1; KVar 0]; KLit 3]
rec [fn<2>]
fun later (func fn<2>, i31, i31) : i31 := KTail (KApp (KVar 2) [KVar 1]) [KVar 0]
rec []
fun half (i31) : i31 := KTail (KApp (KGlobal add3) [KLit 4]) [KVar 0]
rec []
fun alias (i31) : i31 := KTail (KApp (KGlobal natAdd) [KLit 1]) [KVar 0]
rec []
fun main () : i31 := KTail (KGlobal natAdd) [KApp (KGlobal natAdd) [KApp (KGlobal half) [KLit 5]; KApp (KGlobal alias) [KLit 2]]; KApp (KGlobal later) [KGlobal natAdd; KLit 4; KLit 6]]
