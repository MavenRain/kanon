rec []
fun step (i31, i31) : i31 := KTail (KGlobal natAdd) [KVar 1; KVar 0]
rec []
fun chain (i31, i31) : i31 := KTail (KGlobal step) [KApp (KGlobal natAdd) [KVar 1; KLit 1]; KVar 0]
rec []
fun outer (i31, i31) : i31 := KTail (KGlobal chain) [KApp (KGlobal natAdd) [KVar 1; KLit 2]; KVar 0]
rec []
fun main () : i31 := KTail (KGlobal outer) [KLit 3; KLit 4]
