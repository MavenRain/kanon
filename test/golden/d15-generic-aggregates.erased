rec [any]
fun id (union any) : union any := KVar 0
rec [any; pair<union any,union any>]
fun box (union any) : struct pair<union any,union any> := KStruct pair<union any,union any> [KVar 0; KVar 0]
rec [pair<union any,union any>; any]
fun first (struct pair<union any,union any>) : union any := KLet scrut (KVar 0) (KLet a (KProj pair<union any,union any> 0 (KVar 0)) (KLet y (KProj pair<union any,union any> 1 (KVar 1)) (KVar 1)))
rec [any; tuple<union any,union any>]
fun pack (union any) : struct tuple<union any,union any> := KStruct tuple<union any,union any> [KVar 0; KVar 0]
rec [any; sum<union any|union any>]
fun choose (union any) : union sum<union any|union any> := KTag sum<union any|union any> 1 [KVar 0]
rec [sum<union any|union any>; any]
fun unchoose (union sum<union any|union any>) : union any := KCase sum<union any|union any> (KVar 0) [{0 1 (KVar 0)}; {1 1 (KVar 0)}]
rec [any]
fun fromEmpty () : i31 := KCase any (KErased) []
rec [sum<i31|i31>]
fun sumNat () : i31 := KCase sum<i31|i31> (KApp (KGlobal id) [KApp (KGlobal choose) [KLit 7]]) [{0 1 (KVar 0)}; {1 1 (KTail (KGlobal natAdd) [KVar 0; KLit 1])}]
rec [pair<struct pair<i31,i31>,struct pair<i31,i31>>; pair<i31,i31>]
fun nested () : i31 := KLet scrut (KLet scrut (KApp (KGlobal box) [KApp (KGlobal box) [KLit 5]]) (KLet a (KProj pair<struct pair<i31,i31>,struct pair<i31,i31>> 0 (KVar 0)) (KLet y (KProj pair<struct pair<i31,i31>,struct pair<i31,i31>> 1 (KVar 1)) (KVar 1)))) (KLet a (KProj pair<i31,i31> 0 (KVar 0)) (KLet y (KProj pair<i31,i31> 1 (KVar 1)) (KVar 0)))
rec []
fun inc (i31) : i31 := KTail (KGlobal natAdd) [KVar 0; KLit 1]
rec [tuple<func fn<1>,func fn<1>>]
fun fromClosure () : i31 := KTail (KProj tuple<func fn<1>,func fn<1>> 0 (KApp (KGlobal pack) [KGlobal inc])) [KLit 8]
rec [pair<i31,i31>; tuple<i31,i31>; sum<i31|i31>]
fun main () : i31 := KTail (KGlobal natAdd) [KApp (KGlobal natAdd) [KApp (KGlobal first) [KStruct pair<i31,i31> [KLit 3; KLit 4]]; KProj tuple<i31,i31> 1 (KApp (KGlobal pack) [KLit 9])]; KApp (KGlobal natAdd) [KApp (KGlobal unchoose) [KTag sum<i31|i31> 0 [KLit 2]]; KApp (KGlobal natAdd) [KGlobal sumNat; KApp (KGlobal natAdd) [KGlobal nested; KGlobal fromClosure]]]]
