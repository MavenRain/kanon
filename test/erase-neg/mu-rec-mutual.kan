-- mu-rec-mutual: a structural recursion over the mutual family (M1
-- Stage I, brief 3.8, M1-PLAN.md:171).  "sizeA" and "sizeB" are one
-- recursive group, joined by the word "and" of SI-D8, and each member
-- calls its sibling at a leg binder of a branch whose scrutinee is the
-- argument at position 0.  One order answers for the whole group, so
-- both members decrease at the same position (SI-D7, M1-PLAN.md:113).
--
-- The file stands here and not under fixtures because the driver
-- refuses its erased form:  an erasure at a mu shape answers the
-- interim word of Stage J until Stage J lands the rows (SG-D7, SI-D12,
-- M1-PLAN.md:214).  The checked form of the file is the SI-G7 reading.

mu N : Type 0 with
| zero : N
| succ : N -> N

mu A : Type 0 with
| leaf : A
| node : B -> A
and B : Type 0 with
| cons : A -> B

def rec sizeA : A -> N := fun (a : A) => case a as x in A return N with | leaf => zero | node b => succ (sizeB b)
and sizeB : B -> N := fun (b : B) => case b as x in B return N with | cons a => succ (sizeA a)
