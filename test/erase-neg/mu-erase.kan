-- mu-erase: the interim erasure word of brief 3.8 and SG-D7.  The file
-- checks, because the mu shape has a rule pack from this stage, and it
-- erases to the interim word that names the stage which brings the real
-- arm, M1 Stage J (A6).  SG-M5 removes the SMu case of lib/erase.ml and
-- this fixture reads the generic past-M0 word instead.

mu N : Type 0 with
| zero : N
| succ : N -> N

def one : N := succ zero
