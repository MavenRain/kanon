-- a06: the empty collection at both formers.  "()" is the section and
-- "absurd" is the elimination with no branch.
-- Neither type has an M0 production, so both arrive as axioms.

axiom Unit : Type 0
axiom Empty : Prop

def u : Unit := ()
def uTuple : Unit := tuple ()
def fromEmpty : (0 A : Type 0) -> (x : Empty) -> A :=
  fun (0 A : Type 0) (x : Empty) => absurd x
